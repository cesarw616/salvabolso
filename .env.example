# Copie este arquivo para ".env" e ajuste os valores.

# Caminho do banco SQLite local. Use um caminho ABSOLUTO (troque pelo caminho
# real da pasta do projeto na sua máquina) — com Turbopack em modo dev, um
# caminho relativo não é resolvido de forma confiável e o Prisma falha com
# "Unable to open the database file".
DATABASE_URL="file:/caminho/absoluto/para/o/projeto/prisma/dev.db"

# Gere um valor aleatório com: npx auth secret
AUTH_SECRET=""
